{
  "name": "aquaplus-service",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "clean": "node -e \"['dist','dist-server'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/regressions.test.ts",
    "test:rules:run": "tsx --test tests/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aquaplus-service --config firebase.emulator.json \"npm run test:rules:run\"",
    "cap:sync": "npm run build && cap sync android",
    "cap:build": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "cap:open": "cap open android",
    "ota": "npm run build && npx @capgo/cli bundle upload com.aquaplus.service -c production,dev"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-updater": "^8.53.0",
    "@google/genai": "^2.4.0",
    "@grpc/grpc-js": "^1.14.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
