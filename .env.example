# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where the web app and Express API are hosted.
APP_URL="MY_APP_URL"

# Optional public API URL embedded in native Android builds (not a secret).
# Leave empty for web deployments served by the same Express server.
# For Android, set this to the deployed HTTPS backend URL before npm run cap:build,
# or save the URL in Settings > Backend API URL after installing the app.
VITE_API_BASE_URL=""

# Firebase project and Firestore database used by the server Admin SDK.
FIREBASE_PROJECT_ID="positive-drake-n4mm2"
FIRESTORE_DATABASE_ID="ai-studio-4b6f33c0-20b1-4c18-b179-368ff6878ffb"
OWNER_EMAILS="nisanth.t9c@gmail.com,aquaplusrosales@gmail.com,vishaalchinnan@gmail.com"
BUSINESS_PHONE="+91 70103 29920"

# Cloud Scheduler authentication. Keep this token in Secret Manager.
SCHEDULER_OWNER_UID="YOUR_FIREBASE_OWNER_UID"
SCHEDULER_BEARER_TOKEN="GENERATE_A_LONG_RANDOM_SECRET"

# Meta WhatsApp Business Platform Cloud API
WHATSAPP_ACCESS_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="MY_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_TEMPLATE_NAME="service_maintenance_reminder"
WHATSAPP_GRAPH_API_VERSION="v25.0"
# Meta webhook: keep the app secret and random verification token server-side.
WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="GENERATE_A_LONG_RANDOM_WEBHOOK_TOKEN"
# The owner-controlled number allowed by the live test endpoint (E.164 recommended).
WHATSAPP_TEST_RECIPIENT="+91XXXXXXXXXX"

# Owner Daily Digest Email Delivery (Resend)
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="Aqua Plus RO Tech <reports@your-verified-domain.com>"
